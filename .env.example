# ─────────────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────────────

# Port the signaling server listens on
PORT=3001

# The origin of the frontend (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Environment
NODE_ENV=development

# ─────────────────────────────────────────────────────────
# CLIENT (Vite — prefix VITE_ to expose to browser)
# ─────────────────────────────────────────────────────────

# In development, leave blank — Vite proxy handles it.
# In production, set to your server URL if frontend and
# backend are on different origins.
# VITE_SERVER_URL=https://your-domain.com

# ─────────────────────────────────────────────────────────
# WEBRTC — TURN SERVER (Optional but recommended for
# college/corporate networks with restrictive firewalls)
# ─────────────────────────────────────────────────────────

# Get a free TURN server from:
#   https://www.metered.ca/tools/openrelay/
#   https://xirsys.com/ (free tier)

# VITE_TURN_URL=turn:relay.example.com:3478
# VITE_TURN_USERNAME=your-username
# VITE_TURN_CREDENTIAL=your-password
